# Copy to .env (never commit it) or set these in your host's dashboard.

# Required: the PostgreSQL connection string.
DATABASE_URL=postgres://user:password@localhost:5432/granvilles
# Set to "require" if your database needs SSL and the URL doesn't say sslmode=require.
# PGSSL=require

# First owner login. Created once, on first start, if no users exist yet.
# Leave blank to create the owner from the /admin/ setup screen instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Ted

# If set, the /admin/ first-run setup screen asks for this code (protects a fresh deploy).
SETUP_TOKEN=

# AI assistant (optional). Without a key the portal uses built-in rule-based insights.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Google reviews on the home page (optional). A Google Maps Platform key with "Places API (New)" enabled.
# Without a key the reviews section stays hidden. GOOGLE_PLACE_ID is optional (the café is looked up by name).
GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=

# The café's time zone, used for "busiest hour" and daily totals.
BUSINESS_TZ=America/Vancouver

# Set to 1 to load sample sales, customers and stock on first start (removable from Settings).
SEED_DEMO=0

PORT=3000
